{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>casse-boubou/.github//.github/renovate.json"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "datasourceTemplate": "repology",
      "packageNameTemplate": "alpine_3_24/{{package}}",
      "depNameTemplate": "{{package}}",
      "matchStrings": [
        "\\s(?<package>[a-z0-9][a-z0-9-_]+)=(?<currentValue>[a-z0-9-_.]+)\\s"
      ],
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "rustdesk/rustdesk-server",
      "depNameTemplate": "Rustdesk-server",
      "matchStrings": [
        "(ARG)\\s(RUSTDESK_SERVER.*_VERSION)=\"(?<currentValue>v?[0-9]+\\.[0-9]+(\\.[0-9]+){0,1})\"\\n"
      ],
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/", "//build.yaml$/"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "BASE_IMAGE",
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ARG BUILD_FROM=(?<packageName>.*?):(?<currentValue>.*?)\\s+",
        "(aarch64|amd64):\\s[\"']?(?<packageName>.*?):(?<currentValue>.*?)[\"']?\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/", "//build.yaml$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ARG BUILD_FROM=(?<depName>.*?):(?<currentValue>.*?)\\s+",
        "(aarch64|amd64):\\s[\"']?(?<depName>.*?):(?<currentValue>.*?)[\"']?\\s"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-tags"],
      "matchDepNames": ["rustdesk/rustdesk-server"],
      "commitMessagePrefix": "✨",
      "commitMessageTopic": "{{depName}}"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchDepNames": ["BASE_IMAGE"],
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "⬆️ MAJOR",
      "commitMessageTopic": "App Base Image",
      "groupName": "HomeAssistant App Base Image"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchDepNames": ["BASE_IMAGE"],
      "matchUpdateTypes": ["minor", "patch"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "App Base Image",
      "groupName": "HomeAssistant App Base Image",
      "automerge": true
    }
  ]
}